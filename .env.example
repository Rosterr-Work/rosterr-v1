# ---------------------------------------------------------------------------
# Rosterr — environment configuration
# Copy this file to .env (Prisma CLI) and/or .env.local (Next.js runtime)
# and fill in real values. Never commit real secrets.
# ---------------------------------------------------------------------------

# MySQL connection string
DATABASE_URL="mysql://rosterr_app:password@localhost:3306/rosterr"

# Session cookie encryption — generate with: openssl rand -base64 32
# Must score 4/4 on zxcvbn strength or the app refuses to start.
SESSION_SECRET=""

# Encrypts stored Discord bot tokens and other credentials at rest.
# Generate with: openssl rand -base64 64
ENCRYPTION_KEY=""

# Restricts the session cookie to this domain in production (e.g. .example.com).
# Leave unset for a single-domain deployment.
COOKIE_DOMAIN=""

# Discord OAuth2 (Discord Developer Portal → OAuth2)
# Redirect URI must exactly match what's registered there.
# Scopes requested: identify email
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="https://app.rosterr.cc/api/auth/discord/callback"

# Roblox OAuth2 ("Sign in with Roblox" — an alternative to Discord sign-in; either can start, but both a
# Discord and a Roblox account must end up linked, same rule the Discord-first flow already enforces).
# Off entirely, on the login page and everywhere else, until BOTH of these are set — leave unset until
# Roblox has approved the OAuth app. Redirect URI must exactly match what's registered there.
# Scopes requested: openid profile
ROBLOX_CLIENT_ID=""
ROBLOX_CLIENT_SECRET=""
ROBLOX_REDIRECT_URI="https://app.rosterr.cc/api/auth/roblox/callback"

# Set to "true" only when running multiple app instances behind a load
# balancer, to enable cross-instance-safe batch scheduling.
NEXT_MULTI="false"

# Stripe billing (Dashboard → Developers → API keys / Webhooks / Products)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
# Leave empty until Business is ready to sell: the plan then shows as "Coming soon" everywhere and cannot be bought.
STRIPE_BUSINESS_PRICE_ID=""

# Used to build absolute redirect/return URLs for Stripe Checkout and the
# Billing Portal. Falls back to the request's Host header if unset.
NEXT_PUBLIC_APP_URL="https://app.rosterr.cc"

# --- Rosterr Discord bot ---
# One bot serves three jobs: reading a member's roles in the Rosterr staff Discord server for the platform portal
# below, and (for Free and Pro workspaces) sending staff DMs and creating Discord events. It can
# be the same Discord application as the login one above. Business workspaces bring their own bot
# token in the web portal instead. Setup notes: docs/discord-bot.md
DISCORD_BOT_TOKEN=""
# Only if the bot is a different Discord application from the login one:
# DISCORD_BOT_CLIENT_ID=""
# DISCORD_BOT_CLIENT_SECRET=""
# Normally not needed: Rosterr asks Discord for the bot application's public key (it verifies slash
# command requests). Set it only to pin the key.
# DISCORD_BOT_PUBLIC_KEY=""
# Keeps the shared bot and every workspace's own bot connected to Discord so they show as online.
# On in production by default; set "off" on every instance but one if you run more than one (each
# instance would otherwise open its own connection per bot). Off in development unless set to "on".
# DISCORD_GATEWAY="on"
# The channel in Rosterr's own Discord server where status page incidents are posted (Platform > Status). The
# bot needs to be able to post there. Leave unset to post incidents by email only. docs/status-page.md
# STATUS_DISCORD_CHANNEL_ID=""

# Where Business and priority workspaces book their onboarding call from Settings > Support (a scheduling page, https).
# Unset, the button opens live chat instead.
# ONBOARDING_BOOKING_URL=""

# Rosterr Assistant (Pro and Business): the Claude API key it answers with. Leave unset to keep the assistant switched off.
# Anthropic is listed as a subprocessor (Legal > Subprocessors): tell workspace owners 14 days before switching it on. docs/assistant.md
# ANTHROPIC_API_KEY=""

# AI-writing checks on job application answers (Pro and Business, off per workspace until it is turned on in Hiring settings).
# Every detector with a key is asked about each written answer and the scores are averaged. Set as many as you can afford. docs/ai-checks.md
# The detectors are listed as subprocessors: tell workspace owners 14 days before setting the first key.
# GPTZERO_API_KEY=""
# SAPLING_API_KEY=""
# WINSTON_API_KEY=""
# ORIGINALITY_API_KEY=""
# Also ask Claude for a second opinion, with ANTHROPIC_API_KEY above. It is a language model, not a trained detector.
# AI_CHECK_CLAUDE="false"

# --- Platform admin portal (/platform) ---
# Set these to your Discord server and its "Platform Admin" role; override on other deployments.
# PLATFORM_GUILD_ID="YOUR_DISCORD_SERVER_ID"
# PLATFORM_ADMIN_ROLE_ID="YOUR_ADMIN_ROLE_ID"
# Discord user IDs (comma separated) allowed to claim the first Super Admin. Ignored once one exists.
PLATFORM_SUPER_ADMIN_DISCORD_IDS=""
# Passkeys for platform staff are tied to this host (default: the host of NEXT_PUBLIC_APP_URL). Changing it later invalidates them.
# PLATFORM_WEBAUTHN_RP_ID=""
# PLATFORM_WEBAUTHN_ORIGIN=""
# People with a passkey normally can't use the Discord code any more; set true to allow it as a fallback.
# PLATFORM_ALLOW_CODE_FALLBACK="false"
# Hard-to-undo staff actions need a fresh confirmation; "off" disables that (only while the phone apps can't show it).
# PLATFORM_FRESH_STEP_UP="on"

# --- Push notifications (docs/push-notifications.md) ---
# Browsers and home-screen web apps. Generate a pair with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
# Android (Firebase Cloud Messaging): a Firebase service-account key, the whole JSON file base64-encoded.
# FCM_SERVICE_ACCOUNT_BASE64=""
# iPhone (Apple Push Notification service): the .p8 key file's text base64-encoded, plus its IDs.
# APNS_KEY_BASE64=""
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_BUNDLE_ID="cc.rosterr.app"
# APNS_ENVIRONMENT="production"   # "sandbox" only for a build run straight from Xcode

# --- App downloads (/download) ---------------------------------------------------------------
# The public TestFlight link for the iPhone app (https only). Without it the page says "Coming soon".
# TESTFLIGHT_URL="https://testflight.apple.com/join/XXXXXXXX"

# --- Intercom chat (see docs/intercom.md) ------------------------------------------------------
# The chat bubble is off until both of these are set. NEXT_PUBLIC_ values are baked in at build time, so run
# `npm run build` after changing them.
# NEXT_PUBLIC_INTERCOM_APP_ID="abc12345"        # Intercom: Settings > Installation > Web ("workspace ID")
# INTERCOM_API_SECRET=""                        # Intercom: Settings > Channels > Messenger > Security. Never expose this.
# NEXT_PUBLIC_INTERCOM_REGION="us"              # "us", "eu" or "ap" (Australia): where your Intercom workspace is hosted
# INTERCOM_SECURITY="jwt"                       # "jwt" (recommended) or "hmac" (the older identity verification)
# INTERCOM_WEBHOOK_SECRET=""                    # Intercom Developer Hub app > Basic info > Client secret. Lets replies ping people.
# INTERCOM_ACCESS_TOKEN=""                      # Intercom: Settings > Integrations > Developer Hub > your app > Authentication > Access token.
#                                                # Sends people's name, email and mailing-list choice to Intercom's Contacts API (welcome
#                                                # emails, the mailing list, support) at sign-up and whenever they change it. Separate from
#                                                # INTERCOM_API_SECRET above, which never sends an email. Off (nothing sent) until this is set.


# --- Waitlist ("coming soon") ---------------------------------------------------------------------
# While this is on (the default), the public home page says "coming soon", new accounts have to apply for early access,
# and only approved people can use the site. Everyone who already had an account was let in by the migration.
# Set it to "off" on launch day to open the site to everyone. See docs/waitlist.md.
# WAITLIST_MODE="on"

# --- VPN block (see docs/vpn-block.md) ------------------------------------------------------------
# Refuses VPNs, proxies and Tor on the signed-in app and the sign-in routes. Off until VPN_BLOCK is "on".
# VPN_BLOCK="on"
# VPN_CHECK_PROVIDER="proxycheck"               # or "ipqs" (IPQualityScore, which needs a key)
# VPN_CHECK_KEY=""                              # the provider's key; proxycheck.io works without one for a small daily allowance
# VPN_ALLOW_IPS=""                              # never blocked, e.g. your own address or an office: "1.2.3.4, 5.6.7.0/24"
# VPN_BLOCK_IPS=""                              # always blocked, whatever the provider says

# --- Mail: an inbox for every member, at <name>.<workspace>@<MAIL_DOMAIN> (see docs/mail.md) -------------------------------
# Mail stays off until MAIL_INBOUND_SECRET is set. Sending also needs MAIL_SMTP_URL.
# MAIL_DOMAIN="rosterr.cc"                       # the domain mail is for (its MX record must point at this server)
# MAIL_INBOUND_SECRET=""                        # shared secret between the mail listener / mail server and the site (any long random text)
# MAIL_SITE_URL="http://127.0.0.1:3000"         # for the listener: where the site is, as seen from the server
# MAIL_LISTEN_PORT="25"                         # for the listener: the port it accepts mail on
# MAIL_TLS_KEY_FILE="" MAIL_TLS_CERT_FILE=""    # for the listener: a real certificate, so other servers can encrypt the connection
# MAIL_SMTP_URL="smtp://127.0.0.1:587"          # where outgoing mail is handed over: your mail server, or a relay such as smtp://user:pass@host:587
# MAIL_ENVELOPE_FROM=""                         # for mail servers that only let a login send as itself: the technical sender (people still see their own address)
# MAIL_NOREPLY_ADDRESS="no-reply@rosterr.cc"    # the sender of Rosterr's own emails (billing, staff actions, alerts). Sent through MAIL_SMTP_URL, or
#                                               # with mailcow (and no MAIL_SMTP_URL) as a no-reply mailbox the site makes on mailcow itself
# MAIL_NOREPLY_PASSWORD=""                      # only if you made that mailbox in mailcow yourself: its password
# MAIL_PLATFORM_CC=""                          # copied (Cc) on Rosterr's own emails; default "Rosterr Automation | Rosterr <automation@example.com>", "off" to stop

# --- Abuse scan (utils/abuseScan.ts): after every start and once a day, someone owning more than the limit of Free workspaces has all
# their workspaces suspended, an abuse report raised, and is emailed (copying abuse@rosterr.cc) ---------------------------------------
# ABUSE_SCAN=""                                 # "off" to stop it, "report" to only log what it would do
# ABUSE_GRACE_HOURS="72"                        # how long an owner has after the warning before they are suspended (0 = no warning, suspend at once)
# ABUSE_FREE_WORKSPACE_LIMIT="3"                # how many Free workspaces one person may own
# ABUSE_SCAN_EXEMPT_USER_IDS=""                 # Roblox user ids the scan leaves alone, comma separated (Rosterr staff always are)
# MAIL_ALLOWED_IPS=""                           # for the listener: only accept connections from these IPs (your mail server)
# MAIL_UNKNOWN_RECIPIENTS="reject"              # for the listener: "discard" when it sits behind another mail server, so nothing is bounced
# MAIL_ABUSE_ADDRESS="abuse@rosterr.cc"          # shown in the footer of emails to new people

# --- Mail server (mailcow): the site makes a real mailbox for every inbox, and logs in to it (see docs/mail.md) -------------------
# With these set, MAIL_SMTP_URL and the listener are not needed.
# MAIL_AUTHSERV_ID="mail.example.com"    # the name your mail server puts first in its Authentication-Results header (default: the host of MAILCOW_API_URL)
# MAILCOW_API_URL="https://mail.example.com"    # mailcow's web address
# MAILCOW_API_KEY=""                            # a read/write API key, restricted to this server's IP address
# MAIL_IMAP_HOST="" MAIL_IMAP_PORT="993"        # where to read mail (default: the API host, 993)
# MAIL_SMTP_HOST="" MAIL_SMTP_PORT="465"        # where to send mail (default: the API host, 465; use 587 for STARTTLS)
# MAILCOW_QUOTA_MB="50"                         # size of each mailbox; mail is removed from mailcow once the site has it
# CLAMAV_HOST=""                                # a ClamAV server (clamd) that checks every attachment for viruses; mailcow runs one. Without it only the built-in checks run
# CLAMAV_PORT="3310"
# MAIL_ATTACHMENT_QUOTA_MB="100"                # how much room for attachments each inbox gets in the site's database (files are up to 10 MB each)
# Business workspaces' own email domains (liam@theirgroup.com) need nothing more than the above. Optional:
# MAIL_MX_HOST=""                               # the host their MX record must point at (default: the mailcow API host); must be mailcow's hostname
# MAIL_DNS_SERVERS="1.1.1.1,8.8.8.8"            # resolvers used for the "Check DNS" button (public ones, so a cached "not found" here doesn't hold it up)

# --- Separate addresses for the site, the app, the API, avatars and webhooks (see docs/domains.md) ------------------------------
# Nothing changes until at least one of SITE_URL, API_URL, AVATAR_URL or HOOKS_URL is set. Any other host (the old address,
# localhost, an IP) carries on exactly as before.
# SITE_URL="https://rosterr.cc"                 # the marketing site
# SITE_ALIASES="www.rosterr.cc"                 # other names for it; they redirect to SITE_URL
# NEXT_PUBLIC_APP_URL="https://app.rosterr.cc"  # the app (sign-in, workspaces, the platform portal). Also set NEXTAUTH_URL and DISCORD_REDIRECT_URI to it
# API_URL="https://api.v1.prod.rosterr.cc"      # the public API (/workspace/<id>/...), with API keys
# AVATAR_URL="https://ava.v1.prod.rosterr.cc"   # /<userId>.png and /g/<groupId>.png, public and cached; also used for the picture in emails
# HOOKS_URL="https://hooks.rosterr.cc"          # /stripe, /intercom, /staffr/<id>, /discord/interactions/...
# DISCORD_REDIRECT_URIS=""                     # other Discord sign-in redirects still in use (the old address), comma separated; each must be in the Discord portal
# ROBLOX_REDIRECT_URIS=""                       # same idea, for Roblox sign-in redirects
# COOKIE_DOMAIN=""                              # leave empty: the sign-in cookie then belongs to the app's address only

# --- Business: a workspace's own domain, through Cloudflare for SaaS (see docs/custom-domains.md) ---------------------------------
# Off until all three are set. Also needs NEXT_PUBLIC_APP_URL (where members sign in) and COOKIE_DOMAIN left empty.
# CLOUDFLARE_API_TOKEN=""                       # a token for the zone below with SSL and Certificates: Edit (custom hostnames)
# CLOUDFLARE_ZONE_ID=""                         # the zone that has Cloudflare for SaaS turned on (for example rosterr.cc)
# CUSTOM_DOMAIN_CNAME_TARGET=""                 # the hostname customers point their CNAME at, for example customers.rosterr.cc (the zone's fallback origin)
# CUSTOM_DOMAIN_EDGE_KEY=""                    # a long random secret (32+ characters) shared with the Cloudflare Worker in cloudflare/custom-domain-worker.js
# INTERNAL_URL="http://127.0.0.1:3000"          # optional: where the site reaches itself, if it isn't on PORT / 3000

# --- App Store / Play Store review: a fixed sign-in code that never expires, for reviewers who can't do the
# normal 90-second QR flow (see pages/api/auth/qr/claim.ts and scripts/seed-demo-account.mts). Off unless both are set.
# APP_REVIEW_CODE=""                            # at least 12 random characters (shorter or repetitive codes are refused); a code from the alphabet in utils/qrLoginCode.ts (no I, L, O, 0, 1); give this exact code to Apple/Google
# APP_REVIEW_USER_ID=""                         # the demo user's userid (seed-demo-account.mts prints it) that code signs in as

# ---- Rosterr's own social media (Platform → Social media; docs/social-media.md) ----
# Each platform is off until its keys are set. Redirect address to register in each app: https://<app>/api/platform/social/callback/<platform>
# SOCIAL_X_CLIENT_ID="" SOCIAL_X_CLIENT_SECRET=""                    # developer.x.com → app → OAuth 2.0 (Web App, confidential)
# SOCIAL_INSTAGRAM_APP_ID="" SOCIAL_INSTAGRAM_APP_SECRET=""           # developers.facebook.com → app → Instagram → API setup with Instagram login
# SOCIAL_TIKTOK_CLIENT_KEY="" SOCIAL_TIKTOK_CLIENT_SECRET=""          # developers.tiktok.com → app (Login Kit + Content Posting API, Direct Post)
# SOCIAL_YOUTUBE_CLIENT_ID="" SOCIAL_YOUTUBE_CLIENT_SECRET=""         # console.cloud.google.com → OAuth client (Web), YouTube Data API v3 on
# SOCIAL_MEDIA_DIR="/opt/Rosterr/storage/social-media"               # where uploaded pictures and videos are kept (default: storage/social-media)
# SOCIAL_SCHEDULER="off"                                             # stops scheduled posts going out from this server

# Google AdSense (utils/ads/rules.ts): ads on the home page and in Free workspaces. Each place shows nothing until its ad unit's slot id
# is set (AdSense > Ads > By ad unit > Display ads; the number after data-ad-slot). The publisher id is in the code.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=""
NEXT_PUBLIC_ADSENSE_SLOT_WORKSPACE=""
