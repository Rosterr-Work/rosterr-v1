generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Workspace {
  groupId               BigInt                   @id @unique
  groupLogo             String?                  @db.Text
  groupName             String?
  lastSynced            DateTime?
  ownerId               BigInt?
  batchId               Int?
  suspendedAt           DateTime?
  suspendedReason       String?                  @db.Text
  suspendedByDiscordId  BigInt?
  /// A priority account: gets a named account manager (Platform → organisation → Priority account), shown in Settings → Support plan
  /// and set as the Intercom owner of its support contacts (utils/intercomCompanies.ts).
  priority              Boolean                  @default(false)
  prioritySince         DateTime?
  /// The account manager, as an Intercom teammate (their admin id there), with their name and email kept for showing.
  accountManagerIntercomId String?               @db.VarChar(32)
  accountManagerName    String?                  @db.VarChar(120)
  accountManagerEmail   String?                  @db.VarChar(254)
  accountManagerAvatar  String?                  @db.Text
  badge                 WorkspaceBadge?
  /// When the workspace was made. Workspaces older than this column were given the time of their first saved setting.
  createdAt             DateTime                 @default(now())
  adjustments           ActivityCorrection[]
  activityHistory       ActivityPeriodSummary[]
  activityResets        ActivityPeriodReset[]
  activitySessions      PlaySession[]
  allies                Alliance[]
  policyLinks           PolicyInvite[]
  quotas                ActivityQuota[]
  quotaCompletions      QuotaCompletion[]
  savedViews            StaffView[]
  sessionTypes          SessionKind[]
  sessionTags           SessionBadge[]
  sessionRoleTemplates  SlotTemplate[]
  sessionRoleCategories SlotTemplateGroup[]
  stickyAnnouncements   HomeAnnouncement?
  apiKey                ApiCredential[]
  config                WorkspaceSetting[]
  departments           StaffDepartment[]
  documents             StaffDocument[]
  inactivityNotices     LeaveNotice[]
  ranks                 MemberRank[]
  roles                 StaffRole[]
  userBook              LogbookEntry[]
  wallposts             WallPost[]
  externalServices      ExternalConnection?
  members               Membership[]
  discordIntegration    DiscordConnection?
  bloxlinkIntegration   BloxlinkConnection?
  playerBans            Ban[]
  recommendations       StaffRecommendation[]
  notifications         InboxNotification[]
  moderationCases       ModerationRecord[]
  moderationLogs        ModerationHistoryEntry[]
  moderationTemplates   ModerationTemplate[]
  documentContainers    DocumentFolder[]
  subscription          Subscription?
  staffrIntegration     StaffrIntegration?
  staffrJobMappings     StaffrJobMapping[]
  staffrHires           StaffrHire[]
  jobListings           JobListing[]
  hiringSettings        HiringSettings?
  hiringWebhooks        HiringWebhook[]
  staffrClaim           StaffrClaim?
  webhookStreams        WebhookStream[]
  goals                 Goal[]
  discordBot            DiscordBot?
  discordChannelPosts   DiscordChannelPost[]
  tasks                 Task[]
  customDomain          WorkspaceDomain?

  @@index([createdAt])
}

model WorkspaceSetting {
  id               Int       @id @default(autoincrement())
  key              String
  value            Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspaceGroupId BigInt
  workspace        Workspace @relation(fields: [workspaceGroupId], references: [groupId])
}

model GameThumbnail {
  placeId    BigInt   @id
  universeId BigInt?
  imageUrl   String   @db.Text
  updatedAt  DateTime @updatedAt
}

model User {
  userid                  BigInt                   @id @unique
  isOwner                 Boolean?
  registered              Boolean?
  picture                 String?                  @db.Text
  username                String?
  displayName             String?
  birthdayDay             Int?
  birthdayMonth           Int?
  banned                  Boolean                  @default(false)
  bannedAt                DateTime?
  bannedBy                String?
  banReason               String?                  @db.Text
  /// "Sign out everywhere else" was used at this time: any sign-in older than this (that has no UserSession row yet) is ended.
  sessionsValidFrom       DateTime?
  discordId               BigInt?                  @unique
  discordUsername         String?
  discordDisplayName      String?
  discordAvatar           String?                  @db.Text
  discordEmail            String?
  discordDmOptOut         Boolean                  @default(false)
  /// Opted out of marketing email (the mailing list, welcome emails). True until the person ticks the box at sign-up or turns it on in
  /// Notification settings, so nobody is on the list without choosing it. Support replies are unaffected — this only controls
  /// Intercom's `unsubscribed_from_emails`.
  mailingListOptOut       Boolean                  @default(true)
  /// Said yes to email about things that concern them (a decision on their leave). Off until the person turns it on themselves: a
  /// manager who types an address into a profile does not switch this on. Separate from the marketing mailing list above.
  emailNotificationsConsent Boolean                @default(false)
  /// How many workspaces this person may own, when a platform admin set it; null means the default (utils/workspaceLimit.ts). It applies
  /// to Rosterr staff too.
  workspaceLimit          Int?
  /// The person's own details, entered once and applied in every workspace they are in (the workspace copies on Membership are kept in step
  /// from here: see utils/account/profile.ts). Only the person edits these; a manager in one workspace cannot change them for all.
  timezone                String?                  @db.VarChar(64)
  contactEmail            String?                  @db.VarChar(254)
  bio                     String?                  @db.VarChar(500)
  pronouns                String?                  @db.VarChar(40)
  language                String?                  @db.VarChar(16)
  /// Who sees the birthday (day and month, never a year): "private" (only them), "managers" or "team" (the default, as before).
  birthdayVisibility      String                   @default("team") @db.VarChar(10)
  /// Who sees the email address: "private", "managers" (the default) or "team".
  emailVisibility         String                   @default("managers") @db.VarChar(10)
  /// When the person is usually free, once for every workspace: [{ day, from, to }] as on MemberAvailability. A workspace row overrides it.
  availability            Json?
  /// When the person last downloaded their own data from Settings, so it can be offered only so often.
  dataExportedAt          DateTime?
  pushDevices             PushDevice[]
  qrLoginCodes            QrLoginCode[]
  waitlistApplication     WaitlistApplication?
  pushPreference          PushPreference?
  notificationSettings    NotificationSettings?
  staffPassport           StaffPassport?
  adjustmentsMade         ActivityCorrection[]     @relation("AdjustmentActor")
  adjustmentsReceived     ActivityCorrection[]     @relation("AdjustmentUser")
  activityHistory         ActivityPeriodSummary[]
  activityResets          ActivityPeriodReset[]
  activitySessions        PlaySession[]
  policyAcknowledgments   PolicySignoff[]
  createdPolicyLinks      PolicyInvite[]
  roleMembers             RoleAssignment[]
  sessions                WorkspaceSession[]
  sessionLogsAsActor      SessionEvent[]           @relation("SessionLogActor")
  sessionLogsAsTarget     SessionEvent[]           @relation("SessionLogTarget")
  sessionNotes            SessionComment[]
  allyVisits              AllianceVisit[]
  apiKey                  ApiCredential[]
  documents               StaffDocument[]
  inactivityNotices       LeaveNotice[]
  ranks                   MemberRank[]
  sessionsRoles           SessionParticipant[]
  writtenBooks            LogbookEntry[]           @relation("bookAdmin")
  book                    LogbookEntry[]           @relation("bookUser")
  info                    UserCredential?
  wallPosts               WallPost[]
  wallPostReactions       WallReaction[]
  managedMembers          Membership[]             @relation("LineManager")
  workspaceMemberships    Membership[]
  Ally                    Alliance[]               @relation("AllianceToUser")
  roles                   StaffRole[]              @relation("StaffRoleToUser")
  localViews              StaffView[]              @relation("UserLocalViews")
  quotaCompletions        QuotaCompletion[]        @relation("UserQuotaCompletions")
  completedQuotas         QuotaCompletion[]        @relation("CompletedByUser")
  notifications           InboxNotification[]
  createdModerationCases  ModerationRecord[]       @relation("CreatedModerationCases")
  resolvedModerationCases ModerationRecord[]       @relation("ResolvedModerationCases")
  reportedModerationCases ModerationRecord[]       @relation("ReportedModerationCases")
  revokedModerationCases  ModerationRecord[]       @relation("RevokedModerationCases")
  targetModerationCases   ModerationRecord[]       @relation("TargetModerationCases")
  moderationEvidence      ModerationAttachment[]
  moderationLogs          ModerationHistoryEntry[]
  documentContainers      DocumentFolder[]

  @@index([birthdayMonth, birthdayDay])
}

model UserCredential {
  userid       BigInt  @id
  passwordhash String?
  tfa          String? @db.Text
  user         User    @relation(fields: [userid], references: [userid])
}

model QuotaTargetRole {
  quotaId String        @db.Char(36)
  roleId  String        @db.Char(36)
  quota   ActivityQuota @relation(fields: [quotaId], references: [id])
  role    StaffRole     @relation(fields: [roleId], references: [id])

  @@unique([quotaId, roleId])
}

model StaffRole {
  id               String            @id @unique @default(uuid()) @db.Char(36)
  permissions      Json              @default("[]")
  isOwnerRole      Boolean?          @default(false)
  workspaceGroupId BigInt
  name             String
  groupRoles       Json              @default("[]")
  color            String?
  quotaRoles       QuotaTargetRole[]
  roleMembers      RoleAssignment[]
  workspace        Workspace         @relation(fields: [workspaceGroupId], references: [groupId])
  SessionType      SessionKind[]     @relation("SessionKindToStaffRole")
  documents        StaffDocument[]   @relation("StaffDocumentToStaffRole")
  members          User[]            @relation("StaffRoleToUser")
  containers       DocumentFolder[]  @relation("DocumentFolderToStaffRole")
}

model RoleAssignment {
  roleId        String    @db.Char(36)
  userId        BigInt
  manuallyAdded Boolean   @default(false)
  createdAt     DateTime  @default(now())
  role          StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@id([roleId, userId])
}

model StaffDepartment {
  id                String                  @id @unique @default(uuid()) @db.Char(36)
  name              String
  color             String?
  workspaceGroupId  BigInt
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  departmentMembers DepartmentAssignment[]
  quotaDepartments  QuotaTargetDepartment[]
  workspace         Workspace               @relation(fields: [workspaceGroupId], references: [groupId])
  SessionType       SessionKind[]           @relation("SessionKindToStaffDepartment")
  documents         StaffDocument[]         @relation("StaffDepartmentToStaffDocument")
  containers        DocumentFolder[]        @relation("DocumentFolderToStaffDepartment")
}

model DepartmentAssignment {
  departmentId     String          @db.Char(36)
  workspaceGroupId BigInt
  userId           BigInt
  department       StaffDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  workspaceMember  Membership      @relation(fields: [workspaceGroupId, userId], references: [workspaceGroupId, userId], onDelete: Cascade)

  @@id([departmentId, workspaceGroupId, userId])
}

model QuotaTargetDepartment {
  quotaId      String          @db.Char(36)
  departmentId String          @db.Char(36)
  department   StaffDepartment @relation(fields: [departmentId], references: [id])
  quota        ActivityQuota   @relation(fields: [quotaId], references: [id])

  @@unique([quotaId, departmentId])
}

model WallPost {
  id               Int            @id @default(autoincrement())
  content          String         @db.Text
  image            String?        @db.LongText
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  workspaceGroupId BigInt
  authorId         BigInt
  author           User           @relation(fields: [authorId], references: [userid])
  workspace        Workspace      @relation(fields: [workspaceGroupId], references: [groupId])
  reactions        WallReaction[]
  /// When the post was pinned to the top of the wall (null: not pinned), and by whom.
  pinnedAt         DateTime?
  pinnedBy         BigInt?
  /// When the author last changed the words (null: never edited).
  editedAt         DateTime?

  @@index([workspaceGroupId, createdAt(sort: Desc)])
  @@index([workspaceGroupId, pinnedAt])
}

model WallReaction {
  id         Int      @id @default(autoincrement())
  emoji      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  wallPostId Int
  userId     BigInt
  post       WallPost @relation(fields: [wallPostId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@unique([wallPostId, userId, emoji])
  @@index([wallPostId])
  @@index([userId])
}

model HomeAnnouncement {
  id               Int       @id @default(autoincrement())
  workspaceGroupId BigInt    @unique
  title            String
  subtitle         String?   @db.Text
  sections         Json
  editorId         BigInt?
  editorUsername   String?
  editorPicture    String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceGroupId], references: [groupId])
}

model AuditEntry {
  id               Int      @id @default(autoincrement())
  workspaceGroupId BigInt
  userId           BigInt?
  action           String
  entity           String?
  details          Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([workspaceGroupId, createdAt])
  @@index([workspaceGroupId, userId])
}

model SessionKind {
  id                 String             @id @unique @default(uuid()) @db.Char(36)
  name               String
  description        String?            @db.Text
  gameId             BigInt?
  allowUnscheduled   Boolean
  workspaceGroupId   BigInt
  statues            Json
  slots              Json
  sessions           WorkspaceSession[]
  workspace          Workspace          @relation(fields: [workspaceGroupId], references: [groupId])
  schedule           SessionSchedule[]
  hostingDepartments StaffDepartment[]  @relation("SessionKindToStaffDepartment")
  hostingRoles       StaffRole[]        @relation("SessionKindToStaffRole")
  sessionTags        SessionBadge[]     @relation("SessionBadgeToSessionKind")
}

model SlotTemplate {
  id               String             @id @unique @default(uuid()) @db.Char(36)
  name             String
  weight           Int                @default(0)
  categoryId       String?            @db.Char(36)
  hostRole         String?
  slots            Int                @default(1)
  groupRoles       Json               @default("[]")
  workspaceGroupId BigInt
  archived         Boolean            @default(false)
  /// A certification a person has to hold (and have valid) to take this role. Null: none.
  requiredCertificationId String?     @db.Char(36)
  createdAt        DateTime           @default(now())
  category         SlotTemplateGroup? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  workspace        Workspace          @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([workspaceGroupId])
  @@index([categoryId])
}

model SlotTemplateGroup {
  id               String         @id @unique @default(uuid()) @db.Char(36)
  name             String
  weight           Int            @default(0)
  workspaceGroupId BigInt
  archived         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  templates        SlotTemplate[]
  workspace        Workspace      @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([workspaceGroupId])
}

model SessionBadge {
  id               String             @id @unique @default(uuid()) @db.Char(36)
  name             String
  color            String
  workspaceGroupId BigInt
  allowedTypes     Json               @default("[]")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sessions         WorkspaceSession[]
  workspace        Workspace          @relation(fields: [workspaceGroupId], references: [groupId])
  sessionTypes     SessionKind[]      @relation("SessionBadgeToSessionKind")

  @@index([workspaceGroupId])
}

model SessionSchedule {
  id            String             @id @unique @default(uuid()) @db.Char(36)
  Days          Json               @default("[]")
  Hour          Int
  Minute        Int
  sessionTypeId String             @db.Char(36)
  sessions      WorkspaceSession[]
  sessionType   SessionKind        @relation(fields: [sessionTypeId], references: [id])
}

model SessionParticipant {
  userid           BigInt
  sessionid        String           @db.Char(36)
  roleID           String
  slot             Int
  archiveEndDate   DateTime?
  archiveStartDate DateTime?
  archived         Boolean?         @default(false)
  session          WorkspaceSession @relation(fields: [sessionid], references: [id])
  user             User             @relation(fields: [userid], references: [userid])

  @@id([userid, sessionid, roleID, slot])
}

model WorkspaceSession {
  id               String               @id @unique @default(uuid()) @db.Char(36)
  name             String?
  type             String?
  ownerId          BigInt?
  date             DateTime
  startedAt        DateTime?
  ended            DateTime?
  sessionTypeId    String               @db.Char(36)
  scheduleId       String?              @db.Char(36)
  sessionTagId     String?              @db.Char(36)
  duration         Int                  @default(30)
  archiveEndDate   DateTime?
  archiveStartDate DateTime?
  archived         Boolean?             @default(false)
  /// Brought in by the import wizard (Settings > Import): the batch, where it came from ("hyra", "series", "csv") and when. Null: made here.
  importBatchId    String?   @db.Char(36)
  importedFrom     String?   @db.VarChar(16)
  importedAt       DateTime?
  owner            User?                @relation(fields: [ownerId], references: [userid])
  schedule         SessionSchedule?     @relation(fields: [scheduleId], references: [id])
  sessionType      SessionKind          @relation(fields: [sessionTypeId], references: [id])
  sessionTag       SessionBadge?        @relation(fields: [sessionTagId], references: [id])
  logs             SessionEvent[]
  notes            SessionComment[]
  users            SessionParticipant[]
  coverRequests    SessionCoverRequest[]
  coverSwaps       SessionCoverSwap[]
  attendance       SessionAttendance[]

  @@index([sessionTypeId, date])
  @@index([importBatchId])
}

model SessionComment {
  id        String           @id @unique @default(uuid()) @db.Char(36)
  sessionId String           @db.Char(36)
  authorId  BigInt
  content   String           @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  author    User             @relation(fields: [authorId], references: [userid])
  session   WorkspaceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SessionEvent {
  id        String           @id @unique @default(uuid()) @db.Char(36)
  sessionId String           @db.Char(36)
  actorId   BigInt
  targetId  BigInt?
  action    String
  metadata  Json?
  createdAt DateTime         @default(now())
  actor     User             @relation("SessionLogActor", fields: [actorId], references: [userid])
  session   WorkspaceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  target    User?            @relation("SessionLogTarget", fields: [targetId], references: [userid])
}

/// "Find cover": someone who can't make a session asks a teammate to take their place (host, or a role's slot), see utils/sessions/cover.ts.
/// The holder stays in the slot until someone takes it. `openKey` is "session:role:slot" while the request is live and NULL once it is closed,
/// so a slot has at most one live request. `roleId` is "host" for the host. No foreign keys to users: they go with the account explicitly.
model SessionCoverRequest {
  id               String             @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  sessionId        String             @db.Char(36)
  roleId           String             @db.VarChar(64)
  slot             Int                @default(0)
  holderId         BigInt // who is in the slot and wants cover
  createdById      BigInt // the holder, or a manager posting for them
  note             String?            @db.VarChar(300)
  status           String             @default("OPEN") @db.VarChar(20) // OPEN | AWAITING_APPROVAL | FILLED | CANCELLED | EXPIRED
  openKey          String?            @unique @db.VarChar(120)
  takerId          BigInt? // who is taking it (waiting for approval, or done)
  swapId           String?            @db.Char(36) // the swap the holder accepted, if it was a swap
  decidedById      BigInt? // the manager who approved, declined or cancelled
  closeReason      String?            @db.VarChar(40)
  closedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  session          WorkspaceSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  swaps            SessionCoverSwap[]

  @@index([workspaceGroupId, status])
  @@index([sessionId])
}

/// A teammate's answer to a cover request: "I'll take yours if you take this one of mine". The holder accepts or declines.
model SessionCoverSwap {
  id        String              @id @default(uuid()) @db.Char(36)
  requestId String              @db.Char(36)
  offererId BigInt
  sessionId String              @db.Char(36) // the offerer's session the holder would take
  roleId    String              @db.VarChar(64)
  slot      Int                 @default(0)
  status    String              @default("PENDING") @db.VarChar(20) // PENDING | ACCEPTED | DECLINED | WITHDRAWN | LAPSED
  createdAt DateTime            @default(now())
  decidedAt DateTime?
  request   SessionCoverRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  session   WorkspaceSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([requestId, offererId])
  @@index([sessionId])
}

model PlaySession {
  id               String    @id @unique @default(uuid()) @db.Char(36)
  userId           BigInt
  active           Boolean
  startTime        DateTime
  endTime          DateTime?
  idleTime         BigInt?
  workspaceGroupId BigInt
  messages         Int?
  universeId       BigInt?
  sessionMessage   String?   @db.Text
  archiveEndDate   DateTime?
  archiveStartDate DateTime?
  archived         Boolean?  @default(false)
  user             User      @relation(fields: [userId], references: [userid])
  workspace        Workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([workspaceGroupId, startTime, archived])
  @@index([workspaceGroupId, active, archived])
  @@index([userId, workspaceGroupId])
}

model ApiCredential {
  id               String    @id @unique
  name             String
  // SHA-256 hex digest of the plaintext key. The plaintext is shown once at creation and never stored.
  key              String    @unique
  keyHint          String    @default("")
  lastUsed         DateTime?
  // Settings v1.10: where the key was last used from (the caller's address and the endpoint it asked for).
  lastUsedIp       String?
  lastUsedPath     String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  workspaceGroupId BigInt
  createdById      BigInt
  createdBy        User      @relation(fields: [createdById], references: [userid])
  workspace        Workspace @relation(fields: [workspaceGroupId], references: [groupId])
}

model LeaveNotice {
  id               String    @id @unique @default(uuid()) @db.Char(36)
  userId           BigInt
  startTime        DateTime
  endTime          DateTime?
  reason           String    @db.Text
  approved         Boolean?  @default(false)
  reviewed         Boolean?  @default(false)
  revoked          Boolean?  @default(false)
  workspaceGroupId BigInt
  reviewComment    String?   @db.Text
  createdAt        DateTime  @default(now())
  approvedAt       DateTime?
  reviewedByUserId BigInt?
  revokedAt        DateTime?
  revokedByUserId  BigInt?
  /// When the person was told their leave is about to start / end (Sessions and Notices v1.7). Null: not yet.
  startRemindedAt  DateTime?
  endRemindedAt    DateTime?
  /// Brought in by the import wizard (Settings > Import): the batch, where it came from ("hyra", "series", "csv") and when. Null: made here.
  importBatchId    String?   @db.Char(36)
  importedFrom     String?   @db.VarChar(16)
  importedAt       DateTime?
  user             User      @relation(fields: [userId], references: [userid])
  workspace        Workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([workspaceGroupId, endTime, startTime, approved, reviewed])
  @@index([workspaceGroupId, userId])
  @@index([importBatchId])
}

model StaffDocument {
  id                     String                        @id @unique @default(uuid()) @db.Char(36)
  name                   String
  content                Json
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  ownerId                BigInt
  workspaceGroupId       BigInt
  acknowledgmentDeadline DateTime?
  isTrainingDocument     Boolean                       @default(false)
  requiresAcknowledgment Boolean                       @default(false)
  acknowledgmentMethod   String?                       @default("signature")
  acknowledgmentWord     String?
  assignToEveryone       Boolean                       @default(false)
  // Documents v1.9: the number of the live version, an unpublished draft kept beside it, and when people were last chased.
  version                Int                           @default(1)
  draftName              String?
  draftContent           Json?
  draftBy                BigInt?
  draftUpdatedAt         DateTime?
  lastChasedAt           DateTime?
  versions               DocumentVersion[]
  acknowledgmentHistory  PolicyAcknowledgmentHistory[]
  acknowledgments        PolicySignoff[]
  shareableLinks         PolicyInvite[]
  owner                  User                          @relation(fields: [ownerId], references: [userid])
  workspace              Workspace                     @relation(fields: [workspaceGroupId], references: [groupId])
  departments            StaffDepartment[]             @relation("StaffDepartmentToStaffDocument")
  roles                  StaffRole[]                   @relation("StaffDocumentToStaffRole")
  containers             DocumentFolder[]              @relation("DocumentFolderToStaffDocument")

  @@index([workspaceGroupId, isTrainingDocument])
}

model DocumentFolder {
  id               String            @id @unique @default(uuid()) @db.Char(36)
  name             String
  description      String?           @db.Text
  workspaceGroupId BigInt
  ownerId          BigInt
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspace        Workspace         @relation(fields: [workspaceGroupId], references: [groupId])
  owner            User              @relation(fields: [ownerId], references: [userid])
  documents        StaffDocument[]   @relation("DocumentFolderToStaffDocument")
  departments      StaffDepartment[] @relation("DocumentFolderToStaffDepartment")
  roles            StaffRole[]       @relation("DocumentFolderToStaffRole")

  @@index([workspaceGroupId])
}

/// A file uploaded for a Policy or a Docs/Guides entry — `document.content`'s {upload: true, attachmentId}
/// shape points at one of these. Not FK'd to `document.id`: like MailAttachment, the file is uploaded
/// before the document exists (the create form uploads first, then creates the document referencing the
/// returned id), so it's a standalone row looked up by id out of the JSON content, same indirection.
model DocumentAttachment {
  id               String                  @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  uploadedBy       BigInt
  filename         String                  @db.VarChar(255)
  contentType      String                  @db.VarChar(120)
  size             Int
  createdAt        DateTime                @default(now())
  blob             DocumentAttachmentBlob?

  @@index([workspaceGroupId])
}

model DocumentAttachmentBlob {
  attachmentId String             @id @db.Char(36)
  data         Bytes              @db.LongBlob
  attachment   DocumentAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

model LogbookEntry {
  id               String    @id @unique @default(uuid()) @db.Char(36)
  userId           BigInt
  type             String
  reason           String    @db.Text
  adminId          BigInt
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspaceGroupId BigInt
  rankAfter        Int?
  rankBefore       Int?
  rankNameAfter    String?
  rankNameBefore   String?
  redacted         Boolean?  @default(false)
  redactedAt       DateTime?
  redactedBy       BigInt?
  /// Brought in by the import wizard (Settings > Import): the batch, where it came from ("hyra", "series", "csv") and when. Null: made here.
  importBatchId    String?   @db.Char(36)
  importedFrom     String?   @db.VarChar(16)
  importedAt       DateTime?
  admin            User      @relation("bookAdmin", fields: [adminId], references: [userid])
  user             User      @relation("bookUser", fields: [userId], references: [userid])
  workspace        Workspace @relation(fields: [workspaceGroupId], references: [groupId])
  attachments      LogbookAttachment[]

  @@index([importBatchId])
}

/// A file attached to a logbook entry: a screenshot, a PDF, a statement. Uploaded first (entryId empty, "staged", only its uploader can
/// open it), then linked when the entry is written. The bytes live in LogbookAttachmentBlob so listing entries never loads a file.
/// Deleting the entry deletes its files. See utils/logbook/attachments.ts.
/// When a member is usually free, as weekly windows in their own time zone (the member's profile zone). Used to suggest who could fill a
/// session's open places. One row per person per workspace; no foreign keys, cleaned up with the workspace and with the account.
model MemberAvailability {
  workspaceGroupId BigInt
  userId           BigInt
  /// [{ day: 0-6 (Monday is 0), from: "HH:MM", to: "HH:MM" }]
  windows          Json
  updatedAt        DateTime @updatedAt

  @@id([workspaceGroupId, userId])
  @@index([workspaceGroupId])
}

/// A person's own record of where they have served, which they can share with a link. Nothing is shown unless they turn sharing on,
/// and only the workspaces they pick appear. Rotating the token ends every old link.
model StaffPassport {
  userId             BigInt   @id
  token              String   @unique @db.Char(32)
  shared             Boolean  @default(false)
  /// Workspace group ids (as strings) that appear on the shared passport.
  workspaces         Json
  showCertifications Boolean  @default(true)
  showRecognition    Boolean  @default(true)
  showAbout          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [userid], onDelete: Cascade)
}

/// A mentor and the person they are helping, inside one workspace. Set up by someone with manage_mentoring; either of the two can end it.
/// No foreign keys on the people: account deletion repoints the person who left to the Deleted User, so the other keeps their record.
model Mentorship {
  id               String    @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  mentorId         BigInt
  menteeId         BigInt
  status           String    @default("ACTIVE") @db.VarChar(10) // ACTIVE | ENDED
  focus            String?   @db.VarChar(300)
  createdBy        BigInt?
  createdAt        DateTime  @default(now())
  endedAt          DateTime?

  @@index([workspaceGroupId, status])
  @@index([mentorId, status])
  @@index([menteeId, status])
}

/// A record of a 1:1, between a person and their line manager or between a mentor and mentee. Only the two of them can read it, and a
/// note marked private is the author's alone.
model OneOnOne {
  id               String   @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  leaderId         BigInt // the line manager, or the mentor
  memberId         BigInt
  kind             String   @db.VarChar(10) // MANAGER | MENTOR
  authorId         BigInt
  heldAt           DateTime
  notes            String   @db.Text
  privateNotes     String?  @db.Text
  /// [{ id, text, done, owner: "leader" | "member" }]
  actions          Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceGroupId, leaderId, memberId, heldAt])
  @@index([memberId])
}

/// Something a person wants to get better at. Theirs to write; their line manager and their mentors can read it.
model DevelopmentGoal {
  id               String    @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  userId           BigInt
  title            String    @db.VarChar(120)
  detail           String?   @db.Text
  targetDate       DateTime?
  status           String    @default("ACTIVE") @db.VarChar(10) // ACTIVE | DONE | DROPPED
  doneAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceGroupId, userId, status])
}

/// A thank-you from one member to another, inside a workspace. No foreign keys on the people, like MemberAvailability: account deletion
/// removes what a person received and repoints what they gave to the Deleted User.
model Recognition {
  id               String   @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  fromUserId       BigInt
  toUserId         BigInt
  message          String   @db.VarChar(280)
  createdAt        DateTime @default(now())

  @@index([workspaceGroupId, createdAt])
  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
}

/// A certification a workspace awards (Lead trainer, First aid...). Holding a valid one can be required to take a session role.
model Certification {
  id               String   @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  name             String   @db.VarChar(100)
  description      String?  @db.Text
  /// How long an award lasts, in days. Null: it does not expire.
  validForDays     Int?
  createdAt        DateTime @default(now())

  @@index([workspaceGroupId])
}

/// One person holding a certification. Revoked rows are kept (who took it away, and when).
model CertificationAward {
  id               String    @id @default(uuid()) @db.Char(36)
  certificationId  String    @db.Char(36)
  workspaceGroupId BigInt
  userId           BigInt
  awardedById      BigInt
  awardedAt        DateTime  @default(now())
  expiresAt        DateTime?
  note             String?   @db.Text
  revokedAt        DateTime?
  revokedById      BigInt?

  @@index([workspaceGroupId, userId])
  @@index([certificationId])
}

/// A request to promote someone, made by one person and decided by another (the promotion pipeline). Approving it writes the promotion
/// in the logbook, which moves the rank through the workspace's ranking service. No foreign keys: it is cleaned up with the workspace
/// by workspace id, and with an account by utils/user/deleteAccount.ts.
model PromotionReview {
  id               String    @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  /// The person being considered.
  userId           BigInt
  requestedById    BigInt
  /// PENDING, APPROVED (the promotion was made), DECLINED or CANCELLED.
  status           String    @default("PENDING") @db.VarChar(12)
  fromRank         Int?
  toRank           Int?
  toRankName       String?   @db.VarChar(100)
  note             String?   @db.Text
  /// What the readiness checks said when it was asked for.
  facts            Json?
  decidedById      BigInt?
  decidedAt        DateTime?
  decisionNote     String?   @db.Text
  createdAt        DateTime  @default(now())
  /// "promotion", or "demotion" for one an automatic rule suggested.
  kind             String    @default("promotion") @db.VarChar(10)
  /// The automatic rule that suggested it (AutoPromotionRule), when a rule did rather than a person. requestedById is then the rule's owner.
  ruleId           String?   @db.Char(36)

  @@index([workspaceGroupId, status])
  @@index([workspaceGroupId, userId])
}

/// An automatic promotion (or demotion) rule: people at one rank who meet its conditions move to the next rank, by themselves or queued
/// for a manager to approve (the default). It runs once a day as its owner (the admin who last saved it), with their permissions. See
/// utils/promotion/autoRules.ts and autoService.ts. No foreign keys: removed with the workspace; an owner's account deletion turns it off.
model AutoPromotionRule {
  id               String   @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  name             String   @db.VarChar(100)
  /// "promotion" or "demotion".
  kind             String   @db.VarChar(10)
  /// "queue" (a manager approves) or "auto".
  mode             String   @default("queue") @db.VarChar(8)
  enabled          Boolean  @default(true)
  fromRank         Int
  toRank           Int
  toRankName       String?  @db.VarChar(100)
  /// The checks, all of which must pass (see Conditions in autoRules.ts).
  conditions       Json
  ownerId          BigInt
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([workspaceGroupId, fromRank, kind])
  @@index([enabled])
}

/// One day's run of a workspace's rules, for the "Last run" shown to admins. Which server runs it is decided by a JobClaim
/// ("auto-promotions:<group>:<day>"). What happened to each person is kept in outcomes.
model AutoPromotionRun {
  id               String    @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  /// The UTC day, "2026-10-20".
  day              String    @db.VarChar(10)
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  moved            Int       @default(0)
  queued           Int       @default(0)
  skipped          Int       @default(0)
  outcomes         Json?

  @@index([workspaceGroupId, startedAt])
}

model LogbookAttachment {
  id               String                  @id @default(uuid()) @db.Char(36)
  entryId          String?                 @db.Char(36)
  workspaceGroupId BigInt
  /// The person the logbook is about.
  userId           BigInt
  uploadedBy       BigInt
  filename         String                  @db.VarChar(255)
  contentType      String                  @db.VarChar(120)
  size             Int
  createdAt        DateTime                @default(now())
  entry            LogbookEntry?           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  blob             LogbookAttachmentBlob?

  @@index([workspaceGroupId, userId])
  @@index([entryId, createdAt])
}

model LogbookAttachmentBlob {
  attachmentId String            @id @db.Char(36)
  data         Bytes             @db.LongBlob
  attachment   LogbookAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

model MemberRank {
  userId           BigInt
  rankId           BigInt
  workspaceGroupId BigInt
  user             User      @relation(fields: [userId], references: [userid], onDelete: Cascade)
  workspace        Workspace @relation(fields: [workspaceGroupId], references: [groupId], onDelete: Cascade)

  @@id([userId, workspaceGroupId])
}

model ActivityQuota {
  id                   String                  @id @default(uuid()) @db.Char(36)
  type                 String
  value                Int?
  workspaceGroupId     BigInt
  name                 String
  description          String?                 @db.Text
  sessionType          String?
  completionType       String?                 @default("auto") // "auto", "user_complete", "manager_signoff"
  workspace            Workspace               @relation(fields: [workspaceGroupId], references: [groupId])
  quotaDepartments     QuotaTargetDepartment[]
  quotaRoles           QuotaTargetRole[]
  userQuotaCompletions QuotaCompletion[]
}

model QuotaCompletion {
  id               String        @id @default(uuid()) @db.Char(36)
  quotaId          String        @db.Char(36)
  userId           BigInt
  workspaceGroupId BigInt
  completed        Boolean       @default(false)
  completedAt      DateTime?
  completedBy      BigInt? // The user who marked it complete (for manager signoff)
  notes            String?       @db.Text
  archived         Boolean       @default(false)
  archiveCycleId   String        @default("active")
  archiveStartDate DateTime?
  archiveEndDate   DateTime?
  quota            ActivityQuota @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  user             User          @relation("UserQuotaCompletions", fields: [userId], references: [userid], onDelete: Cascade)
  completedByUser  User?         @relation("CompletedByUser", fields: [completedBy], references: [userid])
  workspace        Workspace     @relation(fields: [workspaceGroupId], references: [groupId])

  @@unique([quotaId, userId, workspaceGroupId, archived, archiveCycleId])
  @@index([userId, workspaceGroupId])
  @@index([quotaId])
}

model Alliance {
  workspaceGroupId BigInt
  name             String
  icon             String          @db.Text
  groupId          String
  notes            Json            @default("[]")
  id               String          @id @unique @default(uuid()) @db.Char(36)
  discordServer    String?
  theirReps        Json            @default("[]")
  workspace        Workspace       @relation(fields: [workspaceGroupId], references: [groupId])
  allyVisits       AllianceVisit[]
  reps             User[]          @relation("AllianceToUser")
}

model AllianceVisit {
  id           String   @id @unique @default(uuid()) @db.Char(36)
  allyId       String   @db.Char(36)
  hostId       BigInt
  time         DateTime
  name         String
  eventType    String   @default("visit")
  description  String?  @db.Text
  hostRole     String   @default("host")
  participants Json     @default("[]")
  ally         Alliance @relation(fields: [allyId], references: [id])
  host         User     @relation(fields: [hostId], references: [userid])
}

model Membership {
  workspaceGroupId  BigInt
  userId            BigInt
  joinDate          DateTime?
  birthdayDay       Int?
  birthdayMonth     Int?
  discordId         String?
  isAdmin           Boolean?               @default(false)
  lineManagerId     BigInt?
  timezone          String?
  email             String?
  introMessage      String?                @db.Text
  trackId           String?
  trackName         String?
  artistName        String?
  artwork           String?                @db.Text
  previewUrl        String?                @db.Text
  departmentMembers DepartmentAssignment[]
  lineManager       User?                  @relation("LineManager", fields: [lineManagerId], references: [userid], onDelete: NoAction, onUpdate: NoAction)
  user              User                   @relation(fields: [userId], references: [userid])
  workspace         Workspace              @relation(fields: [workspaceGroupId], references: [groupId])

  @@id([workspaceGroupId, userId])
  @@index([userId])
  @@index([lineManagerId])
  @@index([workspaceGroupId, joinDate])
}

model ActivityCorrection {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           BigInt
  actorId          BigInt
  workspaceGroupId BigInt
  minutes          Int
  reason           String?   @db.Text
  createdAt        DateTime  @default(now())
  archiveEndDate   DateTime?
  archiveStartDate DateTime?
  archived         Boolean?  @default(false)
  actor            User      @relation("AdjustmentActor", fields: [actorId], references: [userid])
  user             User      @relation("AdjustmentUser", fields: [userId], references: [userid])
  workspace        Workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([userId])
  @@index([actorId])
  @@index([workspaceGroupId])
  @@index([workspaceGroupId, createdAt, archived])
}

model ActivityPeriodSummary {
  id                      String    @id @default(uuid()) @db.Char(36)
  userId                  BigInt
  workspaceGroupId        BigInt
  periodStart             DateTime
  periodEnd               DateTime
  minutes                 Int
  messages                Int
  sessionsHosted          Int
  sessionsSecondaryHosted Int       @default(0)
  sessionsAttended        Int
  idleTime                Int
  wallPosts               Int       @default(0)
  quotaProgress           Json
  createdAt               DateTime  @default(now())
  /// Brought in by the import wizard (Settings > Import): the batch, where it came from ("hyra", "series", "csv") and when. Null: made here.
  importBatchId    String?   @db.Char(36)
  importedFrom     String?   @db.VarChar(16)
  importedAt       DateTime?
  user                    User      @relation(fields: [userId], references: [userid])
  workspace               Workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([userId])
  @@index([workspaceGroupId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([importBatchId])
}

model ActivityPeriodReset {
  id                  String    @id @default(uuid()) @db.Char(36)
  workspaceGroupId    BigInt
  resetById           BigInt?
  resetAt             DateTime  @default(now())
  previousPeriodStart DateTime?
  previousPeriodEnd   DateTime?
  /// "manual" (someone pressed the button) or "scheduled" (the automatic reset). Null on resets from before it was recorded.
  trigger             String?   @db.VarChar(12)
  /// What the reset did, as counts: people saved to history, sessions, adjustments, session sign-ups, sessions and quota completions archived.
  summary             Json?
  resetBy             User?     @relation(fields: [resetById], references: [userid])
  workspace           Workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([workspaceGroupId])
  @@index([resetAt])
}

model ExternalConnection {
  id                 Int       @id @default(autoincrement())
  workspaceGroupId   BigInt    @unique
  rankingProvider    String?
  rankingToken       String?   @db.Text
  rankingWorkspaceId String?
  robloxApiKey       String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([workspaceGroupId])
}

enum WorkspaceBadge {
  VERIFIED
  PARTNER
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String             @id @default(cuid())
  workspaceGroupId     BigInt             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan   @default(FREE)
  /// ACTIVE by default: a row made before any subscription exists (a checkout that was opened and left) is a Free workspace, not a trial.
  status               SubscriptionStatus @default(ACTIVE)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workspace            Workspace          @relation(fields: [workspaceGroupId], references: [groupId])
}

model StaffView {
  id               String    @id @default(uuid()) @db.Char(36)
  workspaceGroupId BigInt
  name             String
  color            String?
  icon             String?
  filters          Json
  columnVisibility Json
  isLocal          Boolean   @default(false)
  createdBy        BigInt?
  createdAt        DateTime  @default(now())
  order            Int       @default(0)
  workspace        Workspace @relation(fields: [workspaceGroupId], references: [groupId])
  creator          User?     @relation("UserLocalViews", fields: [createdBy], references: [userid])

  @@index([workspaceGroupId])
  @@index([createdBy])
  @@index([workspaceGroupId, isLocal, order])
}

model PolicySignoff {
  id             String        @id @default(uuid()) @db.Char(36)
  userId         BigInt
  documentId     String        @db.Char(36)
  acknowledgedAt DateTime      @default(now())
  ipAddress      String?
  signature      String?       @db.LongText
  isRequired     Boolean       @default(false)
  document       StaffDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [userid])

  @@unique([userId, documentId])
  @@index([userId])
  @@index([documentId])
}

// A past version of a document or policy (Documents v1.9). The live document is `document.version`; each time what people read changes,
// the one it replaces is kept here under its own number. No foreign key to the author, so deleting an account never blocks.
model DocumentVersion {
  id         String        @id @default(uuid()) @db.Char(36)
  documentId String        @db.Char(36)
  version    Int
  name       String
  content    Json
  note       String?       @db.Text
  createdBy  BigInt?
  createdAt  DateTime      @default(now())
  document   StaffDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
}

// Who had agreed to an earlier version of a policy, kept when a new version asks everyone to agree again (Documents v1.9).
// PolicyAcknowledgment always means "agreed to the live version"; this is the record of the versions before it.
model PolicyAcknowledgmentHistory {
  id              String        @id @default(uuid()) @db.Char(36)
  documentId      String        @db.Char(36)
  documentVersion Int
  userId          BigInt
  acknowledgedAt  DateTime
  ipAddress       String?
  signature       String?       @db.LongText
  archivedAt      DateTime      @default(now())
  document        StaffDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, documentVersion])
  @@index([userId])
}

model PolicyInvite {
  id               String        @id @default(uuid()) @db.Char(36)
  documentId       String        @db.Char(36)
  workspaceGroupId BigInt
  name             String
  description      String?       @db.Text
  createdById      BigInt
  createdAt        DateTime      @default(now())
  expiresAt        DateTime?
  isActive         Boolean       @default(true)
  accessCount      Int           @default(0)
  lastAccessed     DateTime?
  createdBy        User          @relation(fields: [createdById], references: [userid])
  document         StaffDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace        Workspace     @relation(fields: [workspaceGroupId], references: [groupId])

  @@index([documentId])
  @@index([workspaceGroupId])
  @@index([createdById])
}

// LEGACY: the pasted-token Discord integration. Nothing reads it any more except scripts/migrate-discord.mts, which moves it onto the bot
// (DiscordBot + DiscordChannelPost). Drop it once that has run everywhere.
