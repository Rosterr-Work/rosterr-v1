  guildId             String
  guildName           String?
  channelId           String
  channelName         String?
  birthdayChannelId   String?
  birthdayChannelName String?
  enabledEvents       Json    @default("[]")
  birthdayEnabled     Boolean @default(false)

  embedTitle     String? @db.Text
  embedColor     String?
  embedFooter    String? @db.Text
  embedThumbnail Boolean @default(true)

  promotionEmbedTitle       String? @db.Text
  promotionEmbedColor       String?
  promotionEmbedDescription String? @db.Text
  promotionEmbedFooter      String? @db.Text

  demotionEmbedTitle       String? @db.Text
  demotionEmbedColor       String?
  demotionEmbedDescription String? @db.Text
  demotionEmbedFooter      String? @db.Text

  warningEmbedTitle       String? @db.Text
  warningEmbedColor       String?
  warningEmbedDescription String? @db.Text
  warningEmbedFooter      String? @db.Text

  terminationEmbedTitle       String? @db.Text
  terminationEmbedColor       String?
  terminationEmbedDescription String? @db.Text
  terminationEmbedFooter      String? @db.Text

  resignationEmbedTitle       String? @db.Text
  resignationEmbedColor       String?
  resignationEmbedDescription String? @db.Text
  resignationEmbedFooter      String? @db.Text

  noticeSubmitEmbedTitle         String? @db.Text
  noticeSubmitEmbedColor         String?
  noticeSubmitEmbedDescription   String? @db.Text
  noticeSubmitEmbedFooter        String? @db.Text
  noticeApprovalEmbedTitle       String? @db.Text
  noticeApprovalEmbedColor       String?
  noticeApprovalEmbedDescription String? @db.Text
  noticeApprovalEmbedFooter      String? @db.Text
  noticeDenialEmbedTitle         String? @db.Text
  noticeDenialEmbedColor         String?
  noticeDenialEmbedDescription   String? @db.Text
  noticeDenialEmbedFooter        String? @db.Text

  birthdayEmbedTitle       String? @db.Text
  birthdayEmbedColor       String?
  birthdayEmbedDescription String? @db.Text

  isActive      Boolean   @default(true)
  lastMessageAt DateTime?
  errorCount    Int       @default(0)
