auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
package-manager-strict=false
# npm only (pnpm ignores this). npm 10.8.2 crashes ("Cannot read properties of null (reading
# 'edgesOut')") while resolving peer dependencies for this tree; skipping peer resolution avoids
# it and a production build works. Note this leaves vitest's `vite` peer uninstalled, so
# `npm test` needs `npm i -D vite` - use pnpm for development and CI, which auto-installs peers.
legacy-peer-deps=true
